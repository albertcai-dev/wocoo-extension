# Copy to .env and fill in from 1Password (WOCOO Triager > Atlassian OAuth 3LO).
# The extension will throw on load if either value is missing.
#
# The OAuth callback URL registered with Atlassian is derived from the extension ID.
# The extension ID is path-derived from wherever the unpacked dist/ folder lives —
# moving the folder = new ext ID = need to re-register the callback URL.

VITE_ATLASSIAN_CLIENT_ID=
VITE_ATLASSIAN_CLIENT_SECRET=
